# Copy to .env and replace all placeholders. Never commit real credentials.
# development/test/production; production requires HTTPS origins and Secure cookies.
APP_ENV=development
# PostgreSQL URL (postgresql or postgresql+psycopg); required, no default.
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE
# Exactly this domain; no subdomains.
UNIVERSITY_EMAIL_DOMAIN=sdu.edu.kz
# JSON array of explicit origins, no paths or wildcard. HTTP only for loopback.
FRONTEND_ORIGINS=["http://localhost:5173"]
# Required independent secret, at least 32 characters; this placeholder is rejected.
JWT_SECRET_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Positive integers; defaults 15 and 7.
JWT_ACCESS_MINUTES=15
REFRESH_SESSION_DAYS=7
# Relative to repository root regardless of current directory; default backend/uploads.
UPLOAD_DIR=backend/uploads
# Defaults: false locally, true in production if omitted; production rejects false.
REFRESH_COOKIE_SECURE=false
# Required browser security defaults; false/other SameSite values rejected.
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SAMESITE=lax
# SMTP is optional until validate_email_delivery() is called. Supply all five
# connection/authentication/sender values then; these commented placeholders
# deliberately do not enable SMTP. Real transport is not implemented yet.
# SMTP_HOST=REPLACE_SMTP_HOST
# SMTP_PORT=587
# SMTP_USERNAME=REPLACE_SMTP_USERNAME
# SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
# SMTP_FROM_EMAIL=REPLACE_SENDER@example.invalid
# starttls (default) or tls; select the server's actual TLS mode/port.
SMTP_SECURITY=starttls
